# UniPortal ERP deployment environment template
# Copy to .env for local development only. Never commit a populated .env file.
# Production deployments must inject secrets through the platform secret manager.
# Node.js 22.x and pnpm 9.15.x are the supported toolchain.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PROCESS_ROLE=api
API_PORT=3001
API_PREFIX=api/v1
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# Runtime URL: restricted uniportal_app role; use DATABASE_DIRECT_URL for the
# system/advisory-lock client and MIGRATE_DATABASE_URL only for schema jobs.
DATABASE_URL=postgresql://uniportal_app:CHANGE_ME@localhost:5432/uniportal_dev
DATABASE_DIRECT_URL=postgresql://uniportal_system:CHANGE_ME@localhost:5432/uniportal_dev
MIGRATE_DATABASE_URL=postgresql://uniportal:uniportal_dev_pass@localhost:5432/uniportal_dev
DATABASE_TEST_URL=postgresql://uniportal:uniportal_dev_pass@localhost:5432/uniportal_test
# Optional read replica for reporting workloads.
REPORTING_DATABASE_URL=
# Legacy compatibility alias; prefer REPORTING_DATABASE_URL.
PRISMA_REPORTING_URL=

# ─── Redis / BullMQ ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Managed Redis may provide a complete redis:// or rediss:// URL.
# REDIS_URL=redis://:password@redis.example.com:6379

# ─── JWT RS256 authentication ─────────────────────────────────────────────────
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#          openssl rsa -pubout -in private.pem -out public.pem
# Encode:  base64 -w 0 private.pem; base64 -w 0 public.pem
JWT_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_ENCODED_RS256_PRIVATE_KEY
JWT_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_ENCODED_RS256_PUBLIC_KEY
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# ─── Encryption and privacy ───────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
# Optional stable salt for privacy-erasure pseudonyms. Keep stable for the life
# of the installation; do not rotate casually because it changes pseudonyms.
NDPR_PSEUDONYM_SALT=

# ─── Browser, CORS, and proxy ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
# Next.js consumes this at build time; it is not a runtime API secret.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=unused-unless-your-deployment-adds-NextAuth

# ─── S3-compatible private and public storage ─────────────────────────────────
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=true
S3_UPLOADS_BUCKET=uniportal-dev-uploads
S3_REPORTS_BUCKET=uniportal-dev-reports
S3_STATIC_BUCKET=uniportal-dev-static
# Local development only. Prefer workload identity / IAM role in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Email ────────────────────────────────────────────────────────────────────
SES_FROM_ADDRESS=
SES_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS ──────────────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=UniPortal

# ─── Public admissions ────────────────────────────────────────────────────────
# Required before public application/status operations are enabled.
ADMISSIONS_TRACKING_SECRET=

# ─── Payment gateways ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_BASE_URL=https://api.paystack.co
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_WEBHOOK_SECRET=
REMITA_SERVICE_TYPE_ID=
REMITA_RRR_ENDPOINT=
REMITA_STATUS_ENDPOINT=
REMITA_STATUS_VERIFICATION_ENABLED=false
PAYMENT_PROVIDER_TIMEOUT_MS=10000

# ─── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_API_TTL=60000
THROTTLE_API_LIMIT=100

# ─── Queue administration and reliability ─────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SHUTDOWN_TIMEOUT_MS=10000
SLOW_QUERY_MS=500
REQUEST_TIMEOUT_MS=30000
MAX_REPORT_EXPORT_ROWS=25000

# ─── Docker / release orchestration ────────────────────────────────────────────
# These variables are used by docker-compose.prod.yml. For the lightweight
# localhost profile, the built-in development database credentials are enough.
POSTGRES_USER=uniportal
POSTGRES_PASSWORD=uniportal_dev_pass
POSTGRES_DB=uniportal
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_SYSTEM_PASSWORD=CHANGE_ME
API_HOST_PORT=3001
WEB_HOST_PORT=3000
RUN_DB_SCHEMA=false
SCHEMA_DEPLOYMENT_MODE=push

# ─── Optional test and seed variables ─────────────────────────────────────────
# Only for local/test commands; do not use seed credentials in production.
# SEED_INSTITUTION_NAME=University of Lagos
# SEED_INSTITUTION_CODE=UNILAG
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=change-me-for-local-seeding
# E2E_TEST_EMAIL=e2e@example.test
# E2E_TEST_PASSWORD=change-me-for-e2e
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# RUN_LIVE_CONTRACT_TESTS=false
# ANALYZE=false

# MFA note: MFA secrets, backup codes, and mandatory-role policy are stored in
# PostgreSQL and encrypted using ENCRYPTION_KEY_HEX. There is no separate MFA
# environment variable to provision. Ensure the encryption key is stable and
# backed up before enabling mandatory MFA roles.

