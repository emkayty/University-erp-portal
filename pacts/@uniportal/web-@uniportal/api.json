{
  "consumer": {
    "name": "@uniportal/web"
  },
  "interactions": [
    {
      "description": "a login request with valid credentials",
      "providerStates": [
        {
          "name": "a user with email student@test.uniportal.ng exists and is not MFA-enrolled"
        }
      ],
      "request": {
        "body": {
          "email": "student@test.uniportal.ng",
          "password": "correct-horse-battery-staple"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.password": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/auth/login"
      },
      "response": {
        "body": {
          "data": {
            "accessToken": "eyJhbGciOiJSUzI1NiIs...",
            "requiresMfa": false,
            "user": {
              "email": "student@test.uniportal.ng",
              "id": "uuid",
              "primaryRole": "STUDENT"
            }
          },
          "success": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.user.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.user.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.user.primaryRole": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.2"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "@uniportal/api"
  }
}