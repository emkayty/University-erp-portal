{
  "name": "@uniportal/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "start:standalone": "bash ../../scripts/start-web.sh",
    "lint": "eslint app hooks lib stores components proxy.ts next.config.ts --ext .ts,.tsx --max-warnings 0",
