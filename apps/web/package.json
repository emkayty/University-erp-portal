    "test": "jest --passWithNoTests --testPathIgnorePatterns='test/(pact|e2e)'",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:pact:consumer": "jest --config test/pact/jest-pact-consumer.config.ts"
  },
