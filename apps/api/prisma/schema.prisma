// ── Payslip ───────────────────────────────────────────────────────────────────
// PARTITIONED (P10): PARTITION BY RANGE (pay_period_date), monthly.
// See: docs/CHANGELOG.md "payments + payslips partitioning deferred to P10"
// and prisma/migrations/0008_p10_partition_payments_payslips for the DDL.
//
// P10 NOTE — partition key is `payPeriodDate`, NOT `createdAt`:
// computePayroll() upserts one Payslip per (staffId, payrollRunId) and MUST
// stay idempotent across retries (a partially-failed run is recomputed).
// Postgres requires the partition key inside the uq_payslip_staff_run
// constraint once partitioned. Using createdAt there would reintroduce the
// same retry-breaks-idempotency problem documented on the Payment model,
// since a retry's createdAt differs from the original attempt's. payPeriodDate
// is instead DERIVED from the immutable payrollRun.periodYear/periodMonth
// (first-of-month), so it is identical on every retry — adding it to the
// unique constraint is then a no-op for uniqueness (it's functionally
// determined by payrollRunId) while satisfying the partitioning rule.
model Payslip {
  id                 String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId            String   @db.Uuid
  payrollRunId       String   @db.Uuid
  payPeriodDate      DateTime @db.Date // first-of-month, derived from payrollRun.periodYear/periodMonth — see model doc
  // Earnings
  basicSalary        Decimal  @db.Decimal(12, 2)
  housingAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal  @default(0) @db.Decimal(12, 2)
  medicalAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  otherAllowances    Decimal  @default(0) @db.Decimal(12, 2)
  grossPay           Decimal  @db.Decimal(12, 2)
  // Statutory deductions
  payeeTax           Decimal  @default(0) @db.Decimal(12, 2) // PAYE (NRS, formerly FIRS — renamed under the NRS Establishment Act 2025, eff. 1 Jan 2026)
  pensionEmployee    Decimal  @default(0) @db.Decimal(12, 2) // 8% min (PenCom)
  pensionEmployer    Decimal  @default(0) @db.Decimal(12, 2) // 10% (PenCom)
  nhfDeduction       Decimal  @default(0) @db.Decimal(12, 2) // 2.5% NHF
  nhisDeduction      Decimal  @default(0) @db.Decimal(12, 2)
  // Voluntary / other deductions
  otherDeductions    Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions    Decimal  @db.Decimal(12, 2)
  netPay             Decimal  @db.Decimal(12, 2)
  // Snapshot of grade at time of payroll (audit-proof)
  gradeLevel         String   @db.VarChar(10)
  ippisNo            String?  @db.VarChar(20)
  createdAt          DateTime @default(now())

  staff      Staff      @relation(fields: [staffId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@id([id, payPeriodDate])
  @@unique([staffId, payrollRunId, payPeriodDate], name: "uq_payslip_staff_run", map: "uq_payslip_staff_run")
  @@index([staffId, createdAt], map: "idx_payslip_staff_date")
  @@index([payrollRunId], map: "idx_payslip_run")
  @@index([payPeriodDate], map: "idx_payslip_period")
  @@map("payslips")
}

