// ═══════════════════════════════════════════════════════════════════════════════
// UniPortal ERP — Prisma Schema
// Phase 0: Foundation models (User, Auth, Audit, Settings)
// ═══════════════════════════════════════════════════════════════════════════════
// CRITICAL: This is the single source of truth for the database schema.
// - Run `pnpm db:migrate:dev --name <description>` to create migrations
// - Run `pnpm db:generate` to regenerate the Prisma client
// - NEVER modify the database directly — all changes go through migrations
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Audit remediation R2: this used to be DATABASE_DIRECT_URL, which
  // apps/api/src/database/direct-prisma.service.ts ALSO reads for its
  // runtime advisory-lock connection. Sharing one env var meant "the
  // non-pooled migrate connection" and "the app's non-pooled runtime
  // connection" were forced to be the same role — fine when both were the
  // owner/superuser, but wrong now that the runtime connection must be the
  // restricted `uniportal_app` role (see migration
  // 0011_p10_rls_role_separation) while `prisma migrate deploy` still
  // needs owner privileges to run DDL. Split into its own var so each can
  // point at the right role independently.
  directUrl = env("MIGRATE_DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 1: Identity & Authentication
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(15)
  passwordHash String    @db.VarChar(255)
  isActive     Boolean   @default(true)
  // MFA (TOTP) — secret is encrypted at application layer before storage
  mfaSecret    String?   @db.VarChar(128)
  mfaEnabled   Boolean   @default(false)
  lastLoginAt  DateTime?
  // Soft-delete: set by application middleware — never hard-delete
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles            UserRole[]
  delegationsGranted  RoleDelegation[] @relation("DelegationGrantor")
  delegationsReceived RoleDelegation[] @relation("DelegationDelegatee")
  sessions         Session[]
  auditLogsAsActor AuditLog[]        @relation("AuditActor")
  notificationLogs NotificationLog[]
    mfaBackupCodes   MfaBackupCode[] // FIX H7
  identityCardsIssued IdentityCard[] @relation("IdentityCardIssuedBy")
  identityCardsRevoked IdentityCard[] @relation("IdentityCardRevokedBy")
  // Module relations — added per phase
  student                 Student? // CB-1 fix: Prisma 1:1 requires both sides
  waiverRequestsInitiated FeeWaiver[]        @relation("WaiverRequestedBy")
  waiverDecisions         FeeWaiver[]        @relation("WaiverApprovedBy")
  staff                   Staff?
  attendanceRecorded      AttendanceRecord[] @relation("AttendanceRecordedBy")
  examAttendanceRecorded  ExamAttendance[]   @relation("ExamAttendanceRecordedBy")
  gradeUploadBatches      GradeUploadBatch[]
  lmsGradedSubmissions    LmsSubmission[] @relation("LmsSubmissionGrader")
  lmsDiscussionPosts      LmsDiscussionPost[] @relation("LmsDiscussionAuthor")
  libraryLoans            LibraryLoan[]
  // staff    Staff?     (added in P6)
  // alumni   Alumni?    (added in P8)

  // P10: NDPR "right to restriction of processing" (spec §16.1) — set by
  // PrivacyService.restrictProcessing(). Modules that run non-essential
  // processing (marketing/analytics-style jobs, not core academic/financial
  // operations a student/staff member is entitled to) should check this
  // flag; core operations continue since restriction ≠ suspension of service.
  processingRestricted Boolean @default(false)

  // P10: NDPR data-subject-rights + security-incident relations
  dsrRequestsAsSubject   DataSubjectRequest[]              @relation("DsrSubjectUser")
  dsrRequestsFiled       DataSubjectRequest[]              @relation("DsrRequestedBy")
  securityIncidentsFiled SecurityIncident[]                @relation("IncidentReportedBy")
  policyAcknowledgements UniversityPolicyAcknowledgement[]
  accessibilitySupportAssignments ApplicationAccessibilityRequest[] @relation("AccessibilitySupportOfficer")
  applicationChangeRequestsReviewed ApplicationChangeRequest[] @relation("ApplicationChangeRequestReviewer")

  @@index([email], map: "idx_users_email_active")
  @@index([phone], map: "idx_users_phone_active")
  @@map("users")
}

model UserRole {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  roleName      RoleName
  // ABAC scope for STAFF role: { "scopes": ["lecturer"], "deptId": "uuid" }
  staffScope    Json?
  grantedAt     DateTime  @default(now())
  effectiveFrom DateTime  @default(now())
  effectiveUntil DateTime?
  revokedAt     DateTime?
  revokedBy     String?   @db.Uuid
  grantReason   String?   @db.VarChar(500)
  grantedBy     String?   @db.Uuid // userId of admin who granted this role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleName], name: "uq_user_role", map: "uq_user_role")
  @@index([userId, effectiveFrom, effectiveUntil, revokedAt], map: "idx_user_roles_effective")
  @@index([roleName, effectiveFrom, effectiveUntil, revokedAt], map: "idx_user_roles_role_effective")
  @@map("user_roles")
}

enum DelegationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model RoleConflictRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleA     RoleName
  roleB     RoleName
  code      String   @unique @db.VarChar(80)
  reason    String   @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleA, roleB], map: "uq_role_conflict_pair")
  @@index([active], map: "idx_role_conflict_active")
  @@map("role_conflict_rules")
}

model RoleDelegation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegatorId String          @db.Uuid
  delegateeId String          @db.Uuid
  roleName   RoleName
  staffScope Json?
  startsAt   DateTime
  endsAt     DateTime
  status     DelegationStatus @default(ACTIVE)
  reason     String           @db.VarChar(500)
  approvedBy String?          @db.Uuid
  revokedAt  DateTime?
  revokedBy  String?          @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  delegator User @relation("DelegationGrantor", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegatee User @relation("DelegationDelegatee", fields: [delegateeId], references: [id], onDelete: Cascade)

  @@index([delegateeId, status, startsAt, endsAt], map: "idx_role_delegations_delegatee_active")
  @@index([delegatorId, status, startsAt, endsAt], map: "idx_role_delegations_delegator_active")
  @@map("role_delegations")
}

enum RoleName {
  SUPER_ADMIN
  VC
  REGISTRAR
  DEAN
  HOD
  STAFF
  BURSAR
  HR_MANAGER
  SUPPORT_STAFF
  STUDENT
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  // Refresh token is stored as a SHA-256 hash — never the raw token
  refreshTokenHash String    @unique @db.VarChar(255)
  expiresAt        DateTime
  // Device information for session management UI
  deviceInfo       Json?
  // Set when user logs out or admin revokes
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expiry")
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: Audit Logging (append-only, immutable)
// IMPORTANT: Never UPDATE or DELETE rows in this table.
// Monthly range partitioning is applied via raw SQL migration after first deploy.
// ═══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?     @db.Uuid // null = system action
  action      AuditAction
  targetTable String      @db.VarChar(60)
  targetId    String?     @db.Uuid
  // PII fields in oldValues/newValues are replaced with "[ENCRYPTED]"
  oldValues   Json?
  newValues   Json?
  ipAddress   String?     @db.VarChar(45) // IPv4 or IPv6
  sessionId   String?     @db.VarChar(64) // jti claim from JWT
  // Additional context (module-specific metadata)
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_actor_date")
  @@index([targetTable, targetId], map: "idx_audit_target")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@index([action], map: "idx_audit_action")
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  MFA_ENABLED
  MFA_DISABLED
  ROLE_GRANTED
  ROLE_REVOKED
  EXPORT
  ERASURE // NDPR erasure request
  APPROVE
  REJECT
  PUBLISH
  SUSPEND
  RESUME
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: Institution Settings (singleton — max 1 row enforced in app layer)
// ═══════════════════════════════════════════════════════════════════════════════

model InstitutionSettings {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Institutional identity
  institutionName String          @db.VarChar(200)
  institutionCode String?         @unique @db.VarChar(20) // NUC institution code
  institutionType InstitutionType @default(UNIVERSITY)
  websiteUrl      String?         @db.VarChar(500)
  contactEmail    String?         @db.VarChar(255)
  contactPhone    String?         @db.VarChar(15)

  // Financial config
  tsaEnabled            Boolean @default(false)
  defaultCurrency       String  @default("NGN") @db.VarChar(3)
  feeWaiverCapHodPct    Decimal @default(30.00) @db.Decimal(5, 2)
  feeWaiverCapBursarPct Decimal @default(80.00) @db.Decimal(5, 2)

  // Academic config
  deanApprovalRequired Boolean       @default(false)
  gradingSystem        GradingSystem @default(NIGERIAN_5_POINT)
  minCreditUnitsPerSem Int           @default(15) @db.SmallInt
  maxCreditUnitsPerSem Int           @default(24) @db.SmallInt

  // Security config
  // JSON array of RoleName values that MUST have MFA enabled
  mfaMandatoryRoles String[] @default(["SUPER_ADMIN", "BURSAR", "VC"])

  // Branding
  primaryColor String? @default("#0056B3") @db.VarChar(7)
  logoUrl      String? @db.VarChar(500)
  faviconUrl   String? @db.VarChar(500)

  // Feature flags: JSON object { module_lms: true, tsa_mode: false, ... }
  // See packages/config/src/feature-flags.ts for all keys
  featureFlags Json @default("{}")

  // CORS allowed origin for the frontend
  corsAllowedOrigin String @default("http://localhost:3000") @db.VarChar(500)

  // FIX M2 (Critical Evaluation): Course repeat/retake policy
  // REPLACE: old F result replaced by new result (only new grade counts)
  // INCLUDE:  both results counted in CGPA (standard punitive approach)
  // BEST:     best result of all attempts counts
  courseRepeatPolicy CourseRepeatPolicy @default(REPLACE)

  // Notification queue config — FIX H10
  // SES rate limit (emails/second). Default: 14 = SES sandbox tier.
  // Raise to 200+ after SES production sandbox exit is approved.
  sesRateLimitPerSecond                Int     @default(14) @db.SmallInt
  // Result notifications concurrency. Set = SES limit to avoid SLA breach.
  resultNotifConcurrency               Int     @default(14) @db.SmallInt
  assessmentFinalExamWeight            Decimal @default(60.00) @db.Decimal(5, 2)
  assessmentContinuousAssessmentWeight Decimal @default(40.00) @db.Decimal(5, 2)
  gradePolicyVersion                   Int     @default(1) @db.SmallInt
  // Matriculation identifiers are institution policy, not application constants.
  // Supported tokens are documented in MatricNumberService.
  matricNumberFormat                   String  @default("{DEPT}/{YEAR}/{SEQ:05}") @db.VarChar(120)
  matricNumberSequenceScope             MatricNumberSequenceScope @default(DEPARTMENT_YEAR)
  // Identity-card layout can use built-in rendering or approved front/back artwork.
  identityCardTemplateMode              IdentityCardTemplateMode @default(BUILT_IN)
  identityCardFrontBackgroundUrl        String? @db.VarChar(500)
  identityCardBackBackgroundUrl         String? @db.VarChar(500)
  identityCardPrimaryColor              String  @default("#0056B3") @db.VarChar(7)
  identityCardAccentColor               String  @default("#C9960C") @db.VarChar(7)
  identityCardFooterText               String? @db.VarChar(160)
  enableLiveGradebook                  Boolean @default(true)
  requireResultValidation              Boolean @default(true)
  requireAdmissionClearance            Boolean            @default(true)
  pendingAdmissionClearance            Boolean?
  pendingAdmissionClearanceEffectiveAt DateTime?
  pendingAdmissionClearanceApprovalRef  String?            @db.VarChar(255)
  feeClearancePolicy                   FeeClearancePolicy @default(SEMESTER_REQUIRED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institution_settings")
}

// FIX M2: Course repeat policy enum
enum MatricNumberSequenceScope {
  GLOBAL
  YEAR
  DEPARTMENT_YEAR
}

enum IdentityCardTemplateMode {
  BUILT_IN
  EXTERNAL_ARTWORK
}

enum CourseRepeatPolicy {
  REPLACE // New grade replaces old F (only new grade counts)
  INCLUDE // All attempts included in CGPA denominator
  BEST // Best result of all attempts used
}

enum FeeClearancePolicy {
  SEMESTER_REQUIRED
  ANNUAL_CLEARANCE
  NO_FINANCIAL_GATE
}

enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE_OF_EDUCATION
  SPECIALIST_INSTITUTION
}

enum GradingSystem {
  NIGERIAN_5_POINT // Default: A=5, B=4, C=3, D=2, E=1, F=0
  US_4_POINT // US scale: A=4, B=3, C=2, D=1, F=0
}

// University policy lifecycle. Each version is immutable after publication;
// a revised policy is created as a new DRAFT with the same policy code and a
// new version string, preserving acknowledgements to historic versions.
enum UniversityPolicyCategory {
  ACADEMIC
  ADMISSIONS
  ASSESSMENT_AND_EXAMINATIONS
  FINANCE_AND_FEES
  STUDENT_AFFAIRS
  STAFF_AND_HR
  RESEARCH_AND_ETHICS
  ICT_AND_DATA_PROTECTION
  HEALTH_SAFETY_AND_SECURITY
  GOVERNANCE_AND_COMPLIANCE
  OTHER
}

enum UniversityPolicyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

model UniversityPolicy {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyCode              String                   @db.VarChar(40)
  version                 String                   @default("1.0") @db.VarChar(30)
  title                   String                   @db.VarChar(250)
  category                UniversityPolicyCategory
  summary                 String?                  @db.Text
  content                 String                   @db.Text
  status                  UniversityPolicyStatus   @default(DRAFT)
  effectiveFrom           DateTime?
  reviewDueAt             DateTime?
  requiresAcknowledgement Boolean                  @default(false)
  acknowledgementDueAt    DateTime?
  submittedAt             DateTime?
  approvedAt              DateTime?
  publishedAt             DateTime?
  archivedAt              DateTime?
  rejectionReason         String?                  @db.Text
  createdById             String                   @db.Uuid
  updatedById             String?                  @db.Uuid
  approvedById            String?                  @db.Uuid
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  acknowledgements UniversityPolicyAcknowledgement[]

  @@unique([policyCode, version], name: "uq_university_policy_version")
  @@index([status, category], map: "idx_university_policy_status_category")
  @@index([effectiveFrom], map: "idx_university_policy_effective_from")
  @@map("university_policies")
}

model UniversityPolicyAcknowledgement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId       String   @db.Uuid
  userId         String   @db.Uuid
  acknowledgedAt DateTime @default(now())
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(512)

  policy UniversityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, userId], name: "uq_university_policy_acknowledgement")
  @@index([userId, acknowledgedAt], map: "idx_university_policy_ack_user")
  @@map("university_policy_acknowledgements")
}

/// Machine-readable academic rules used for deterministic degree-progression
/// decisions. This is separate from UniversityPolicy, which is the published
/// narrative policy/acknowledgement workflow. Every production evaluation must
/// record the selected version and an immutable rule snapshot.
model AcademicPolicyVersion {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyType       String                      @db.VarChar(40)
  scope            AcademicPolicyScope         @default(INSTITUTION)
  scopeId          String?                     @db.Uuid
  priority         Int                         @default(0)
  ruleDefinition   Json
  approvalStatus   AcademicPolicyVersionStatus @default(DRAFT)
  effectiveFrom    DateTime                    @default(now()) @db.Date
  effectiveTo      DateTime?                   @db.Date
  createdById      String?                     @db.Uuid
  approvedById     String?                     @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([policyType, approvalStatus, effectiveFrom], map: "idx_academic_policy_active")
  @@index([scope, scopeId, priority], map: "idx_academic_policy_scope")
  @@map("academic_policy_versions")
}

enum AcademicPolicyScope {
  INSTITUTION
  FACULTY
  DEPARTMENT
  PROGRAMME
}

enum AcademicPolicyVersionStatus {
  DRAFT
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdentityCardHolderType {
  STUDENT
  STAFF
}

enum IdentityCardStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
  REPLACED
}

model IdentityCard {
  id                          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  holderType                  IdentityCardHolderType
  studentId                   String?                @db.Uuid
  staffId                     String?                @db.Uuid
  cardNumber                  String                 @unique @db.VarChar(80)
  serialNumber                String                 @unique @db.VarChar(80)
  issueDate                   DateTime               @default(now()) @db.Date
  expiryDate                  DateTime               @db.Date
  status                      IdentityCardStatus     @default(ACTIVE)
  photoUrl                    String?                @db.VarChar(500)
  verificationTokenHash       String                 @unique @db.VarChar(64)
  verificationTokenCiphertext String                 @db.VarChar(512)
  verificationCount           Int                    @default(0)
  lastVerifiedAt              DateTime?
  lifecycleReason             String?                @db.VarChar(500)
  issuedById                  String                 @db.Uuid
  revokedById                 String?                @db.Uuid
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  student                     Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff                       Staff?                 @relation(fields: [staffId], references: [id], onDelete: Cascade)
  issuedBy                    User                   @relation("IdentityCardIssuedBy", fields: [issuedById], references: [id])
  revokedBy                   User?                  @relation("IdentityCardRevokedBy", fields: [revokedById], references: [id])

  @@index([holderType, status], map: "idx_identity_card_holder_status")
  @@index([studentId, status], map: "idx_identity_card_student_status")
  @@index([staffId, status], map: "idx_identity_card_staff_status")
  @@index([expiryDate, status], map: "idx_identity_card_expiry_status")
  @@map("identity_cards")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: Notifications (cross-cutting — templates + delivery log)
// ═══════════════════════════════════════════════════════════════════════════════

model NotificationTemplate {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey String                  @db.VarChar(100)
  channel     NotificationChannelType
  subject     String                  @db.VarChar(255)
  // Handlebars template body
  // Variables: {{studentName}}, {{matricNo}}, etc.
  body        String                  @db.Text
  // Metadata: { "variables": [{ "name": "studentName", "description": "...", "example": "..." }] }
  variables   Json?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  logs NotificationLog[]

  @@unique([templateKey, channel], name: "uq_notif_template_channel", map: "uq_notif_template_channel")
  @@map("notification_templates")
}

model NotificationLog {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Deep-audit fix (Aug 2026): templateId was NOT NULL with no default,
  // yet the only code that ever wrote to this table (notifications
  // .processor.ts's logNotification()) never populated it — nor did it
  // populate templateKey/subject/body, which weren't columns on this model
  // at all despite the code passing them. This table's one write path
  // could not have executed successfully as originally written. Templates
  // in this system are rendered from a hardcoded in-code map
  // (NotificationsProcessor.renderTemplate()), not looked up from
  // NotificationTemplate rows, so templateId is made optional here rather
  // than forcing a template-table lookup/creation the architecture doesn't
  // otherwise use; templateKey/subject/body are added as real columns so
  // the log can stand on its own without a join. See
  // migrations/0014_notification_log_fix and
  // docs/CHANGELOG.md finding 1.3.
  templateId    String?                 @db.Uuid
  templateKey   String                  @db.VarChar(100)
  subject       String                  @db.VarChar(255)
  body          String                  @db.Text
  recipientId   String                  @db.Uuid
  channel       NotificationChannelType
  status        NotificationLogStatus   @default(PENDING)
  failureReason String?                 @db.Text
  sentAt        DateTime?
  readAt        DateTime?
  // Provider response + BullMQ jobId
  metadata      Json?
  createdAt     DateTime                @default(now())

  template  NotificationTemplate? @relation(fields: [templateId], references: [id])
  recipient User                  @relation(fields: [recipientId], references: [id])

  @@index([recipientId, status], map: "idx_notif_recipient")
  @@index([status, createdAt(sort: Desc)], map: "idx_notif_status")
  @@map("notification_logs")
}

enum NotificationChannelType {
  EMAIL
  SMS
  IN_APP
  PUSH
  WHATSAPP
}

enum NotificationLogStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: MFA Backup Codes (FIX H7 — Critical Evaluation)
//
// The original spec had no backup/recovery codes for TOTP MFA.
// For mandatory-MFA roles (super_admin, bursar, vc): if the user loses their
// authenticator device without backup codes, the account is permanently locked.
// This model provides 10 one-time recovery codes issued at TOTP setup.
// ═══════════════════════════════════════════════════════════════════════════════

model MfaBackupCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  // Code is stored as bcrypt hash (cost 10) — never plaintext
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_mfa_backup_user")
  @@map("mfa_backup_codes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 6: Degree Certificate Verification (FIX H4 — Critical Evaluation)
//
// The spec changelog mentioned QR token generation for degree verification but
// no model was defined. Credential fraud is a major concern in Nigerian HE.
// This model supports: generate QR → verify via public endpoint (no auth required).
// ═══════════════════════════════════════════════════════════════════════════════

model DegreeVerificationToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The opaque token embedded in the QR code on the degree certificate
  token          String    @unique @default(dbgenerated("encode(gen_random_bytes(32), 'hex')")) @db.VarChar(64)
  studentId      String    @db.Uuid
  degreeName     String    @db.VarChar(255) // e.g. "Bachelor of Science, Computer Science"
  classAwarded   String    @db.VarChar(50) // e.g. "First Class Honours"
  graduationDate DateTime  @db.Date
  issuedAt       DateTime  @default(now())
  revokedAt      DateTime?
  revokedReason  String?   @db.Text
  // How many times this QR has been scanned (audit/fraud detection)
  verifyCount    Int       @default(0)
  lastVerifiedAt DateTime?

  // Verification is public — no auth required
  // GET /api/v1/verify/degree?token=<token>

  @@index([token], map: "idx_degree_verify_token")
  @@index([studentId], map: "idx_degree_verify_student")
  @@map("degree_verification_tokens")
}

