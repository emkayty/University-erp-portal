// ── Applicant ──────────────────────────────────────────────────────────────────
model Applicant {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId              String?         @db.Uuid
  applicationNo         String          @unique @db.VarChar(20)
  firstName             String          @db.VarChar(100)
  lastName              String          @db.VarChar(100)
  middleName            String?         @db.VarChar(100)
  dateOfBirth           DateTime        @db.Date
  gender                String          @db.VarChar(20)
  nationality           String          @db.VarChar(100)
  stateOfOrigin         String?         @db.VarChar(100)
  lga                   String?         @db.VarChar(100)
  countryOfOriginId     String?         @db.Uuid
  stateOfOriginId       String?         @db.Uuid
  lgaOfOriginId         String?         @db.Uuid
  phone                 String          @db.VarChar(15)
  email                 String          @db.VarChar(255)
  admissionType         AdmissionType
  admissionCycleId      String          @db.Uuid
  admissionDetails      Json?
  programmeChoice1Id    String          @db.Uuid
  programmeChoice2Id    String?         @db.Uuid
  programmeChoice3Id    String?         @db.Uuid
  // Admission declaration / submission
  submittedAt           DateTime?
  declarationAccepted   Boolean         @default(false)
  declarationAcceptedAt DateTime?
  // JAMB
  jambRegNo             String?         @db.VarChar(20)
  jambScore             Int?            @db.SmallInt
  jambVerified          Boolean         @default(false)
  jambVerifyJobId       String?         @db.VarChar(64)
  // O'level
  oLevelResults         Json?
  oLevelVerified        Boolean         @default(false)
  oLevelVerifyJobId     String?         @db.VarChar(64)
  // NIN — AES-256-GCM encrypted at application layer
  nin                   String?         @db.VarChar(150)
  ninVerified           Boolean         @default(false)
  // Status FSM
  status                ApplicantStatus @default(PENDING)
  capsAdmissionStatus   CapsAdmissionStatus @default(NOT_APPLICABLE)
  capsApplicationReference String?     @db.VarChar(100)
  capsProgramme         String?         @db.VarChar(200)
  capsInstitution       String?         @db.VarChar(200)
  capsApprovedAt        DateTime?
  candidateAcceptedOnCapsAt DateTime?
  lastCapsSyncAt        DateTime?
  offerDate             DateTime?
  offerDeadline         DateTime?
  acceptanceDate        DateTime?
  rejectionDate         DateTime?
  rejectionReason       String?         @db.Text
  // Biometrics (Phase 8+)
  biometricEnrolled     Boolean         @default(false)
  passportPhotoUrl      String?         @db.VarChar(500)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  admissionCycle    AdmissionCycle          @relation(fields: [admissionCycleId], references: [id])
  programmeChoice1  Programme               @relation("AppChoice1", fields: [programmeChoice1Id], references: [id])
  programmeChoice2  Programme?              @relation("AppChoice2", fields: [programmeChoice2Id], references: [id])
  programmeChoice3  Programme?              @relation("AppChoice3", fields: [programmeChoice3Id], references: [id])
  person            Person?                 @relation(fields: [personId], references: [id])
  countryOfOrigin   Country?                @relation("ApplicantOriginCountry", fields: [countryOfOriginId], references: [id])
  stateOrigin       AdministrativeDivision? @relation("ApplicantOriginState", fields: [stateOfOriginId], references: [id])
  lgaOrigin         AdministrativeDivision? @relation("ApplicantOriginLga", fields: [lgaOfOriginId], references: [id])
  student           Student?
  application       Application?
  addresses         Address[]
  guardians         GuardianContact[]
  emergencyContacts EmergencyContact[]

  @@unique([admissionCycleId, jambRegNo], map: "uq_applicant_cycle_jamb")
  @@unique([admissionCycleId, email], map: "uq_applicant_cycle_email")
  @@index([status, admissionType], map: "idx_applicants_status_type")
  @@index([jambRegNo], map: "idx_applicants_jamb")
  @@index([email], map: "idx_applicants_email")
  @@index([personId], map: "idx_applicants_person")
  @@map("applicants")
}

