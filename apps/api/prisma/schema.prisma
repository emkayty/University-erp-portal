  maxCreditUnits Int        @default(180) @db.SmallInt
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  department            Department             @relation(fields: [departmentId], references: [id])
  programmeCourses      ProgrammeCourse[]
  curriculumVersions    CurriculumVersion[]
  students              Student[]
  applicantsChoice1     Applicant[]            @relation("AppChoice1")
  applicantsChoice2     Applicant[]            @relation("AppChoice2")
  applicantsChoice3     Applicant[]            @relation("AppChoice3")
  admissionRequirements AdmissionRequirement[]
  admissionScreenings   AdmissionScreening[]
  admissionOffers       AdmissionOffer[]
  admissionDecisions    AdmissionDecision[]
  feeSchedules          FeeSchedule[]
  transferRequestsFrom  ProgrammeTransferRequest[] @relation("TransferFromProgramme")
  transferRequestsTo    ProgrammeTransferRequest[] @relation("TransferToProgramme")

  @@index([departmentId], map: "idx_programme_dept")
  @@map("programmes")
}

enum DegreeType {
  BSC
  BA
  BENG
  BTECH
  HND
  ND
  MASTERS
  PHD
  DIPLOMA
  PGDIP
  OTHER
}

model Course {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique @db.VarChar(20)
  title         String        @db.VarChar(255)
  creditUnits   Int           @db.SmallInt
  departmentId  String        @db.Uuid
  ccmasCategory CcmasCategory @default(CORE)
  description   String?       @db.Text
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  department       Department           @relation(fields: [departmentId], references: [id])
  programmeCourses ProgrammeCourse[]
  offerings        CourseOffering[]
  prerequisites    CoursePrerequisite[] @relation("CourseHasPrereq")
  requiredBy       CoursePrerequisite[] @relation("PrereqOf")
  academicRequirements AcademicRequirement[]
  equivalenciesFrom CourseEquivalency[] @relation("EquivalencyFrom")
  equivalenciesTo   CourseEquivalency[] @relation("EquivalencyTo")
  transferCreditsMapped AcademicTransferCredit[]
  academicPlanItems AcademicPlanItem[]

  // GIN index for full-text search (raw SQL migration)
  @@index([departmentId, ccmasCategory], map: "idx_course_dept_ccmas")
  @@map("courses")
}

enum CcmasCategory {
  CORE
  ELECTIVE
  GENERAL_STUDIES
}

enum SemesterTerm {
  FIRST
  SECOND
  SUMMER
}

model CoursePrerequisite {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId       String @db.Uuid // course that HAS this prerequisite
  prerequisiteId String @db.Uuid // course that must be passed first
  minGrade       String @default("E") @db.VarChar(2)

  course       Course @relation("CourseHasPrereq", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("PrereqOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId], name: "uq_course_prereq", map: "uq_course_prereq")
  @@map("course_prerequisites")
}

enum CurriculumVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

model CurriculumVersion {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId   String                  @db.Uuid
