// ── MODULE 10: Health Clinic ──────────────────────────────────────────────────
// SECURITY: diagnosis, treatmentNotes, prescriptionNotes and sensitive patient
// demographic/health fields are AES-256-GCM encrypted at the application layer.
// Ciphertext columns are sized for the versioned IV/ciphertext/tag format.
// RLS: patient sees own records; clinic staff sees all; doctor sees assigned records.

model Patient {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @db.Uuid // links to User (student OR staff)
