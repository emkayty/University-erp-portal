  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [stepId], references: [id])

  @@unique([instanceId, stepId])
  @@index([assignedToId, status])
}

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel])
}

model Notification {
  id         String              @id @default(uuid())
  userId     String
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  subject    String?
  body       String
  entityType String?
  entityId   String?
  queuedAt   DateTime            @default(now())
  sentAt     DateTime?
  readAt     DateTime?
  failedAt   DateTime?
  error      String?
  createdAt  DateTime            @default(now())

  @@index([userId, status, createdAt])
  @@index([entityType, entityId])
}

model EnterpriseDocument {
  id                 String                     @id @default(uuid())
  ownerType          String
  ownerId            String
  documentType       String
  classification     DocumentClassification     @default(INTERNAL)
  fileName           String
  storageKey         String
  mimeType           String
  sizeBytes          BigInt
  checksum           String
  verificationStatus DocumentVerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  expiresAt          DateTime?
  createdById        String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([storageKey])
  @@index([ownerType, ownerId])
  @@index([documentType, classification])
}

model IntegrationEndpoint {
  id         String            @id @default(uuid())
  code       String            @unique
  name       String
  baseUrl    String?
  status     IntegrationStatus @default(ACTIVE)
  timeoutMs  Int               @default(10000)
  retryLimit Int               @default(3)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  deliveries IntegrationDelivery[]
}

model IntegrationDelivery {
  id            String            @id @default(uuid())
  endpointId    String
  eventType     String
  eventId       String
  status        IntegrationStatus @default(ACTIVE)
  attemptCount  Int               @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  responseCode  Int?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
}

model SearchIndexEntry {
  id           String             @id @default(uuid())
  documentType SearchDocumentType
  documentId   String
  title        String
  searchable   String
  scopeKey     String?
  active       Boolean            @default(true)
  updatedAt    DateTime           @updatedAt
  createdAt    DateTime           @default(now())

  @@unique([documentType, documentId])
  @@index([scopeKey, active])
}

// P4 INTELLIGENCE & AUTOMATION
enum RuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  RETIRED
}

enum RuleActionType {
  NOTIFY
  CREATE_TASK
  FLAG
  REQUEST_REVIEW
  ESCALATE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model BusinessRule {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  description  String?
  domain       String
  version      Int        @default(1)
  status       RuleStatus @default(DRAFT)
  condition    Json
  actions      Json
  createdById  String?
  approvedById String?
  activatedAt  DateTime?
  retiredAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  executions RuleExecution[]

  @@index([domain, status])
}

model RuleExecution {
  id           String   @id @default(uuid())
  ruleId       String
  entityType   String
  entityId     String
  result       String
  actionResult Json?
  executedAt   DateTime @default(now())

  rule BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, executedAt])
  @@index([entityType, entityId, executedAt])
}

model EnterpriseAlert {
  id             String        @id @default(uuid())
  severity       AlertSeverity
  status         AlertStatus   @default(OPEN)
  domain         String
  title          String
  message        String
  entityType     String?
  entityId       String?
  assignedToId   String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, severity, createdAt])
  @@index([domain, status])
  @@index([entityType, entityId])
}

model AutomationTask {
  id           String    @id @default(uuid())
  code         String
  title        String
  description  String?
  domain       String
  entityType   String?
  entityId     String?
  assignedToId String?
  status       String    @default("OPEN")
  dueAt        DateTime?
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([domain, status])
}

model OLevelExamAuthority {
  id          String                    @id
  code        String                    @unique
  name        String
  shortName   String
  countryCode String                    @default("NG")
  active      Boolean                   @default(true)
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  types       OLevelExamAuthorityType[]

  @@index([active, sortOrder])
}

model OLevelExamAuthorityType {
  id          String              @id
  authorityId String
  code        String
  name        String
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  authority   OLevelExamAuthority @relation(fields: [authorityId], references: [id], onDelete: Restrict)

  @@unique([authorityId, code])
  @@index([authorityId, active, sortOrder])
}

// ── Academic Intelligence & Progression ─────────────────────────────────────
model AcademicRequirementGroup {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumVersionId  String   @db.Uuid
  code                 String   @db.VarChar(50)
  name                 String   @db.VarChar(200)
  groupType            String   @default("CORE") @db.VarChar(40)
  minCourses           Int?     @db.SmallInt
  maxCourses           Int?     @db.SmallInt
  minCreditUnits       Int?     @db.SmallInt
  maxCreditUnits       Int?     @db.SmallInt
  allowDoubleCounting  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  curriculumVersion    CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  requirements          AcademicRequirement[]
  @@unique([curriculumVersionId, code], map: "uq_academic_requirement_group_code")
  @@index([curriculumVersionId, groupType], map: "idx_academic_requirement_group_type")
  @@map("academic_requirement_groups")
}

model AcademicRequirement {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId                String  @db.Uuid
  courseId               String? @db.Uuid
  isCompulsoryWithinGroup Boolean @default(true)
  createdAt              DateTime @default(now())
  group                  AcademicRequirementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course                 Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  @@unique([groupId, courseId], map: "uq_academic_requirement_course")
  @@index([courseId], map: "idx_academic_requirement_course")
  @@map("academic_requirements")
}

model CourseEquivalency {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCourseId   String   @db.Uuid
  toCourseId     String   @db.Uuid
  direction      String   @default("BIDIRECTIONAL") @db.VarChar(20)
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?
  approvedById   String?  @db.Uuid
  reason         String?  @db.Text
  createdAt      DateTime @default(now())
  fromCourse     Course @relation("EquivalencyFrom", fields: [fromCourseId], references: [id], onDelete: Restrict)
  toCourse       Course @relation("EquivalencyTo", fields: [toCourseId], references: [id], onDelete: Restrict)
  @@unique([fromCourseId, toCourseId], map: "uq_course_equivalency")
  @@index([toCourseId], map: "idx_course_equivalency_to")
  @@map("course_equivalencies")
}

model AcademicExemption {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId              String   @db.Uuid
  curriculumRequirementId String  @db.Uuid
  status                 String   @default("PENDING") @db.VarChar(20)
  reason                 String   @db.Text
  evidenceRef            String?  @db.VarChar(500)
  approvedById           String?  @db.Uuid
  approvedAt             DateTime?
  createdAt              DateTime @default(now())
  student                Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([studentId, curriculumRequirementId], map: "uq_student_academic_exemption")
  @@index([studentId, status], map: "idx_student_academic_exemption_status")
  @@map("academic_exemptions")
}

model AcademicSubstitution {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId                String   @db.Uuid
  curriculumRequirementId  String   @db.Uuid
  substituteCourseId       String   @db.Uuid
  status                   String   @default("PENDING") @db.VarChar(20)
  reason                   String   @db.Text
  evidenceRef              String?  @db.VarChar(500)
  approvedById             String?  @db.Uuid
  approvedAt               DateTime?
  createdAt                DateTime @default(now())

  @@unique([studentId, curriculumRequirementId], map: "uq_student_academic_substitution")
  @@index([studentId, status], map: "idx_student_academic_substitution_status")
  @@map("academic_substitutions")
}

model AcademicTransferCredit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String   @db.Uuid
  sourceInstitution String  @db.VarChar(255)
  sourceCourseCode String?  @db.VarChar(50)
  sourceCourseTitle String? @db.VarChar(255)
  mappedCourseId   String?  @db.Uuid
  creditUnits      Int      @db.SmallInt
  grade            String?  @db.VarChar(10)
  status           String   @default("PENDING") @db.VarChar(20)
  evidenceRef      String?  @db.VarChar(500)
  approvedById     String?  @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mappedCourse     Course? @relation(fields: [mappedCourseId], references: [id], onDelete: Restrict)
  @@index([studentId, status], map: "idx_transfer_credit_student_status")
  @@map("academic_transfer_credits")
}

model DegreeAudit {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String   @db.Uuid
  curriculumVersionId String   @db.Uuid
  status              String   @db.VarChar(30)
  requirementResults  Json
  policySnapshot      Json
  auditedById         String?  @db.Uuid
  createdAt           DateTime @default(now())
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  @@index([studentId, createdAt], map: "idx_degree_audit_student_created")
  @@index([status], map: "idx_degree_audit_status")
  @@map("degree_audits")
}

model ProgressionEvaluation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @db.Uuid
  academicHistoryId  String   @db.Uuid
  policyVersionId    String?  @db.Uuid
  outcome            String   @db.VarChar(30)
  recommendedAction  String   @db.VarChar(40)
  reasons            Json
  policySnapshot     Json
  evaluatedById      String?  @db.Uuid
  createdAt          DateTime @default(now())
  student            Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicHistory   StudentAcademicHistory @relation(fields: [academicHistoryId], references: [id], onDelete: Cascade)
  @@unique([studentId, academicHistoryId, policyVersionId], map: "uq_progression_student_history_policy")
  @@index([studentId, createdAt], map: "idx_progression_student_created")
  @@map("progression_evaluations")
}

model AcademicStanding {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @db.Uuid
  academicHistoryId  String   @db.Uuid
  policyVersionId    String?  @db.Uuid
  standing           String   @db.VarChar(40)
  reasons            Json
  policySnapshot     Json
  determinedById     String?  @db.Uuid
  createdAt          DateTime @default(now())
  student            Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicHistory   StudentAcademicHistory @relation(fields: [academicHistoryId], references: [id], onDelete: Cascade)
  @@unique([studentId, academicHistoryId, policyVersionId], map: "uq_standing_student_history_policy")
  @@index([studentId, createdAt], map: "idx_academic_standing_student_created")
  @@map("academic_standings")
}

model AcademicPlacement {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId                     String   @db.Uuid
  sourceProgressionEvaluationId String?  @db.Uuid
  academicYear                  String   @db.VarChar(9)
  fromLevel                     Int?     @db.SmallInt
  toLevel                       Int      @db.SmallInt
  decision                      String   @db.VarChar(40)
  status                        String   @default("RECOMMENDED") @db.VarChar(20)
  reason                        String?  @db.Text
  policySnapshot                Json
  approvedById                  String?  @db.Uuid
  appliedById                   String?  @db.Uuid
  appliedAt                     DateTime?
  effectiveDate                 DateTime @db.Date
  createdAt                     DateTime @default(now())
  student                       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([sourceProgressionEvaluationId], map: "uq_academic_placement_source_progression")
  @@index([studentId, status, effectiveDate], map: "idx_academic_placement_student_status_date")
  @@map("academic_placements")
}

model AcademicPlan {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String   @db.Uuid
  curriculumVersionId String   @db.Uuid
  status              String   @default("ACTIVE") @db.VarChar(20)
  sourceAuditId       String?  @db.Uuid
  rationale            Json
  createdAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  items               AcademicPlanItem[]
  @@index([studentId, status], map: "idx_academic_plan_student_status")
  @@map("academic_plans")
}

model AcademicPlanItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId       String   @db.Uuid
  courseId     String   @db.Uuid
  sequence     Int      @db.SmallInt
  targetPeriod String?  @db.VarChar(100)
  reason       String?  @db.Text
  status       String   @default("RECOMMENDED") @db.VarChar(20)
  plan         AcademicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course       Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  @@unique([planId, courseId], map: "uq_academic_plan_course")
  @@index([planId, sequence], map: "idx_academic_plan_item_sequence")
  @@map("academic_plan_items")
}

model AcademicAppeal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @db.Uuid
  appealType     String   @db.VarChar(40)
  subjectId      String?  @db.Uuid
  reason         String   @db.Text
  evidenceRef    String?  @db.VarChar(500)
  status         String   @default("SUBMITTED") @db.VarChar(30)
  decision       String?  @db.Text
  decidedById    String?  @db.Uuid
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId, status], map: "idx_academic_appeal_student_status")
  @@map("academic_appeals")
}

model ProgrammeTransferRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String   @db.Uuid
  fromProgrammeId String   @db.Uuid
  toProgrammeId   String   @db.Uuid
  status          String   @default("SUBMITTED") @db.VarChar(30)
  reason          String?  @db.Text
  mappedCredits   Int      @default(0) @db.SmallInt
  decisionNote    String?  @db.Text
  decidedById     String?  @db.Uuid
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromProgramme   Programme @relation("TransferFromProgramme", fields: [fromProgrammeId], references: [id], onDelete: Restrict)
  toProgramme     Programme @relation("TransferToProgramme", fields: [toProgrammeId], references: [id], onDelete: Restrict)
  @@index([studentId, status], map: "idx_programme_transfer_student_status")
  @@map("programme_transfer_requests")
}

model AcademicInterruption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String   @db.Uuid
  type        String   @db.VarChar(30)
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  status      String   @default("REQUESTED") @db.VarChar(20)
  reason      String?  @db.Text
  decidedById String?  @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId, status], map: "idx_academic_interruption_student_status")
  @@map("academic_interruptions")
}

model AcademicCredential {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @db.Uuid
  credentialType String   @db.VarChar(40)
  credentialNo   String   @unique @db.VarChar(80)
  documentHash   String?  @db.VarChar(128)
  status         String   @default("ISSUED") @db.VarChar(20)
  issuedAt       DateTime @default(now())
  revokedAt      DateTime?
  snapshot       Json
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId, credentialType], map: "idx_academic_credential_student_type")
  @@map("academic_credentials")
}
