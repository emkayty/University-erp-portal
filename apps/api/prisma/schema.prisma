  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty    Faculty     @relation(fields: [facultyId], references: [id])
  programmes Programme[]
  courses    Course[]
  students   Student[]
  staff      Staff[]
  hod        Staff?      @relation("DepartmentHod", fields: [hodId], references: [id])

  @@unique([hodId], map: "uq_department_hod")
  @@unique([name, facultyId], map: "uq_dept_name_faculty")
  @@index([facultyId], map: "idx_dept_faculty")
  @@map("departments")
}

model Programme {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String     @db.VarChar(255)
  code           String     @unique @db.VarChar(20)
  departmentId   String     @db.Uuid
  degreeType     DegreeType
  durationYears  Int        @db.SmallInt
