  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([curriculumVersionId, courseId, level, semester], map: "uq_curriculum_course_sem")
  @@index([programmeId, level], map: "idx_prog_course_level")
  @@index([curriculumVersionId, level], map: "idx_curriculum_course_level")
  @@map("programme_courses")
}

