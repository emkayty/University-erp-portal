/// Payment — PARTITIONED (P10): PARTITION BY RANGE (created_at), monthly.
/// See docs/CHANGELOG.md "Payment/Payslip partitioning deferred to P10"
/// and prisma/migrations/0008_p10_partition_payments_payslips for the DDL.
///
/// P10 RESOLUTION of the "cascading FK implications" the deferral noted:
/// Postgres requires the partition key (created_at) to be part of EVERY
/// unique constraint on a partitioned table — including the PK. That breaks
/// the two single-column UNIQUE constraints this model relied on for
/// idempotency (`providerRef`, `idempotencyKey`), because a webhook retry or
/// a client retry naturally has a DIFFERENT created_at than the original
/// attempt, so a composite UNIQUE(x, created_at) would silently fail to
/// catch the duplicate — the exact class of bug already fixed once as NEW-2
/// (double-payment on retry). Nothing else in the schema holds an FK to
/// Payment.id (verified — Payment is a leaf model), so there is no cascading
/// FK to redesign. Instead:
///   - `id` becomes part of a composite @@id([id, createdAt]) to satisfy
///     Postgres's partitioning requirement.
///   - `providerRef` / `idempotencyKey` drop @unique (no longer expressible
///     as a true cross-partition constraint) and become plain indexes.
///   - Idempotency is restored using the SAME advisory-lock pattern already
///     used elsewhere in this codebase (matric no. generation, course
///     registration): PaymentsService wraps the check-then-write in
///     `pg_advisory_xact_lock(hashtext(key))` inside the transaction, which
///     serializes concurrent attempts for the same key without needing a
///     DB-level unique constraint. See payments.service.ts for the patch.
model Payment {
  id             String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentFeeId   String          @db.Uuid
  studentId      String          @db.Uuid
  amount         Decimal         @db.Decimal(12, 2)
  provider       PaymentProvider
  providerRef    String          @db.VarChar(100) // Remita RRR / Paystack reference — NOT globally unique at DB level post-partitioning; see model doc
  status         PaymentStatus   @default(PENDING)
  paidAt         DateTime?
  channel        String?         @db.VarChar(50) // card, bank, ussd, transfer
  metadata               Json?
  initiationLeaseUntil   DateTime?
  idempotencyKey         String?         @db.VarChar(100) // NOT globally unique at DB level post-partitioning; see model doc
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@id([id, createdAt])
  @@index([studentId, status], map: "idx_payment_student_status")
  @@index([providerRef], map: "idx_payment_provider_ref")
  @@index([idempotencyKey], map: "idx_payment_idempotency_key")
  @@index([createdAt], map: "idx_payment_created_at")
  @@index([status, createdAt], map: "idx_payment_status_created") // reconciliation sweep
  @@map("payments")
}

/// Unpartitioned ownership claim for an external/manual receipt reference.
/// Payments themselves are partitioned, so this table supplies global receipt
/// uniqueness without weakening the payment-table partition design.
model PaymentReceiptClaim {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptReference String   @unique @db.VarChar(100)
  paymentId        String   @db.Uuid
  studentFeeId     String   @db.Uuid
  provider         PaymentProvider
  createdAt        DateTime @default(now())

  @@index([paymentId], map: "idx_payment_receipt_claim_payment")
  @@map("payment_receipt_claims")
}

model FeeWaiver {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentFeeId  String  @db.Uuid
  requestedById String  @db.Uuid
  approvedById  String? @db.Uuid

  requestedBy  User         @relation("WaiverRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?        @relation("WaiverApprovedBy", fields: [approvedById], references: [id])
  waiverPct    Decimal      @db.Decimal(5, 2)
  waiverAmount Decimal      @db.Decimal(12, 2)
  reason       String       @db.Text
  status       WaiverStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  decidedAt    DateTime?

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  @@index([studentFeeId, status], map: "idx_waiver_fee_status")
  @@map("fee_waivers")
}

/// DomainEvent — Transactional Outbox table (S1 / H9 fix).
/// Written inside the SAME transaction as the business operation that
/// produced it (e.g. payment.completed alongside the Payment+StudentFee
/// update). OutboxProcessorService polls WHERE processedAt IS NULL every
/// 5s and emits via EventEmitter2 for non-critical side effects
/// (notifications, LMS sync). Guarantees at-least-once delivery — survives
/// process crashes between commit and emit.
model DomainEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType   String    @db.VarChar(100)
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt   DateTime?
  deadLetteredAt DateTime?
  nextAttemptAt DateTime?
  attempts      Int       @default(0) @db.SmallInt
  lastError     String?   @db.Text

  @@index([processedAt, deadLetteredAt, nextAttemptAt, createdAt], map: "idx_outbox_unprocessed")
  @@map("domain_events")
}

