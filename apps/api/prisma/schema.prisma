// ═══════════════════════════════════════════════════════════════════════════
// P10: NDPR 2019 COMPLIANCE — DATA SUBJECT RIGHTS + BREACH NOTIFICATION
// ═══════════════════════════════════════════════════════════════════════════
// Implements the DSR endpoints (spec §16.1) and docs/CHANGELOG.md M7
// (NDPR audit log pseudonymisation on erasure). Both models below are
// durable, DPO-reviewable trails in their own right — a generic AuditLog row
// tells you WHAT field changed; these tell the DPO "how many SARs this
// quarter, which are overdue, which incidents are past T+72h" without
// reconstructing it from generic audit_logs.

enum DsrRequestType {
  ACCESS // SAR — GET /privacy/sar/:userId
  RECTIFICATION // POST /privacy/rectify/:userId
  ERASURE // DELETE /privacy/erase/:userId
  PORTABILITY // GET /privacy/export/:userId
  RESTRICTION // POST /privacy/restrict/:userId
}

enum DsrRequestStatus {
  RECEIVED
  IDENTITY_VERIFICATION_REQUIRED
  VERIFIED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  LEGAL_HOLD
  COMPLETED
  REJECTED
  FAILED
}

/// DataSubjectRequest — one row per NDPR Data Subject Rights action.
model DataSubjectRequest {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          DsrRequestType
  status        DsrRequestStatus @default(RECEIVED)
  subjectPersonId String?          @db.Uuid // canonical data subject identity
  subjectUserId   String?           @db.Uuid // legacy account link; nullable after hard deletion
  requestedById   String            @db.Uuid // self, or DPO acting on their behalf
  reason        String?          @db.Text // required for RESTRICTION; recommended for ERASURE
  reportJobId   String?          @db.Uuid // SAR/portability: link to the async export job (ReportJob)
  vcApprovalId  String?          @db.Uuid // ERASURE only — VC sign-off per spec §16.1 ("super_admin (VC sign-off required)")
  legalHoldNote String?          @db.Text // ERASURE only — records the 7-year academic-record hold exception when it applies
  completedAt   DateTime?
  dueBy         DateTime // SLA clock: 48h for SAR delivery, 30 days otherwise, per spec §16.1
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  subjectPerson Person? @relation("DsrSubjectPerson", fields: [subjectPersonId], references: [id], onDelete: SetNull)
  subjectUser   User?   @relation("DsrSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  requestedBy   User    @relation("DsrRequestedBy", fields: [requestedById], references: [id])

  @@index([subjectPersonId, type], map: "idx_dsr_subject_person")
  @@index([subjectUserId, type], map: "idx_dsr_subject")
  @@index([status, dueBy], map: "idx_dsr_sla_tracking")
  @@map("data_subject_requests")
}

enum SecurityIncidentType {
  CREDENTIAL_BREACH
  DATA_LEAK
  UNAUTHORISED_ACCESS
  MALWARE
  PHYSICAL_BREACH
  THIRD_PARTY_BREACH
  OTHER
}

enum SecurityIncidentStatus {
  DETECTED
  CONTAINED
  NITDA_NOTIFIED
  RESOLVED
}

/// SecurityIncident — implements the §16.1 breach-notification workflow.
/// The T+72h NITDA deadline is DERIVED (detectedAt + 72h) at the service
/// layer rather than stored, so it can never drift out of sync with
/// detectedAt if detectedAt is later corrected.
model SecurityIncident {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            SecurityIncidentType
  status          SecurityIncidentStatus @default(DETECTED)
  description     String                 @db.Text
  affectedUserIds Json // string[] of User.id — Json because a bulk breach can affect thousands
  detectedAt      DateTime               @default(now())
  containedAt     DateTime?
  nitdaNotifiedAt DateTime?
  resolvedAt      DateTime?
  reportedById    String                 @db.Uuid
  dpoNotes        String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  reportedBy User @relation("IncidentReportedBy", fields: [reportedById], references: [id])

  @@index([status, detectedAt], map: "idx_incident_status_date")
  @@map("security_incidents")
}

