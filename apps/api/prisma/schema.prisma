// ── Academic Calendar ─────────────────────────────────────────────────────────
model AcademicCalendar {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYear    String         @unique @db.VarChar(9) // "2024/2025"
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  isActive        Boolean        @default(false)
  status          CalendarStatus @default(DRAFT)
  suspendedAt     DateTime?
  suspendedById   String?        @db.Uuid
  suspendedReason String?        @db.Text
  resumedAt       DateTime?
  resumedById     String?        @db.Uuid
  activatedAt     DateTime?
  activatedById   String?        @db.Uuid
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  events          CalendarEvent[]
  courseOfferings CourseOffering[]
  // P3+: admissionCycles AdmissionCycle[], students Student[], payrollRuns PayrollRun[]

  // DB-level guard: only one active calendar at a time
  // Raw SQL: CREATE UNIQUE INDEX uq_single_active_calendar
  //          ON academic_calendars (is_active) WHERE is_active = TRUE
  @@index([isActive], map: "idx_calendar_is_active")
  @@index([status], map: "idx_calendar_status")
  @@map("academic_calendars")
}

enum CalendarStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
}

model CalendarEvent {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicCalendarId String            @db.Uuid
  name               String            @db.VarChar(255)
  eventType          CalendarEventType
  startDate          DateTime          @db.Date
  endDate            DateTime?         @db.Date
  isPublic           Boolean           @default(true)
  description        String?           @db.Text
  createdAt          DateTime          @default(now())

  calendar AcademicCalendar @relation(fields: [academicCalendarId], references: [id], onDelete: Cascade)

  @@index([academicCalendarId, eventType], map: "idx_calendar_event_type")
  @@map("calendar_events")
}

enum CalendarEventType {
  REGISTRATION_OPEN
  REGISTRATION_CLOSE
  EXAM_START
  EXAM_END
  RESULT_RELEASE
  GRADUATION
  ORIENTATION
  HOLIDAY
  ADMINISTRATIVE
  OTHER
}

// ── Curriculum Hierarchy ──────────────────────────────────────────────────────
model Faculty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(200)
  code      String   @unique @db.VarChar(10)
  deanId    String?  @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  dean        Staff?       @relation("FacultyDean", fields: [deanId], references: [id])

  @@unique([deanId], map: "uq_faculty_dean")
  @@map("faculties")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(10)
  facultyId String   @db.Uuid
  hodId     String?  @db.Uuid
