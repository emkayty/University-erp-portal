  academicExemptions AcademicExemption[]
  transferCredits AcademicTransferCredit[]
  degreeAudits DegreeAudit[]
  progressionEvaluations ProgressionEvaluation[]
  academicStandings AcademicStanding[]
  academicPlacements AcademicPlacement[]
  academicPlans AcademicPlan[]
  appeals AcademicAppeal[]
