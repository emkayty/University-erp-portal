{
  "name": "@uniportal/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest build && PROCESS_ROLE=api node --watch -r ts-node/register -r tsconfig-paths/register dist/apps/api/src/main.js",
    "worker:dev": "nest build && PROCESS_ROLE=worker node --watch -r ts-node/register -r tsconfig-paths/register dist/apps/api/src/worker.js",
    "start": "pnpm run start:prod",
    "start:prod": "PROCESS_ROLE=api node dist/apps/api/src/main.js",
    "start:worker": "PROCESS_ROLE=worker node dist/apps/api/src/worker.js",
    "lint": "eslint src/ --ext .ts --max-warnings 0",
    "type-check": "tsc --noEmit -p tsconfig.json --rootDir ../..",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config jest-e2e.config.ts",
    "test:integration": "jest --config jest-integration.config.ts --runInBand",
    "test:reports": "jest --config jest-integration.config.ts --runInBand test/reports",
    "prisma:generate": "bash ../../scripts/prisma/with-local-schema-env.sh prisma generate",
    "prisma:migrate": "bash ../../scripts/db/deploy-schema.sh",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "bash ../../scripts/prisma/with-local-schema-env.sh prisma validate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "openapi:export": "ts-node src/swagger-export.ts",
    "test:pact:verify": "jest --config test/pact/jest-pact.config.ts",
    "test:pact:verify:live": "RUN_LIVE_CONTRACT_TESTS=true jest --config test/pact/jest-pact.config.ts",
    "seed:k6-test-students": "ts-node ../../scripts/k6/seed-test-students.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "@uniportal/config": "workspace:*",
    "@uniportal/types": "workspace:*",
    "@uniportal/utils": "workspace:*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "cache-manager": "^6.0.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.0.0",
    "@pact-foundation/pact": "^17.1.2",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@uniportal/eslint-config": "workspace:*",
    "@uniportal/tsconfig": "workspace:*",
    "jest": "^29.7.0",
    "pm2": "^5.4.0",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
